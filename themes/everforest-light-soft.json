{
  "base": "light",
  "tokens": {
    "--background": "#f3ead3",
    "--editor-surface": "#f3ead3",
    "--foreground": "#56646c",
    "--card": "#eae4ca",
    "--card-foreground": "#56646c",
    "--popover": "#f3ead3",
    "--popover-foreground": "#56646c",
    "--primary": "#627001",
    "--primary-foreground": "#f3ead3",
    "--secondary": "#eae4ca",
    "--secondary-foreground": "#56646c",
    "--muted": "#eae4ca",
    "--muted-foreground": "#5a6559",
    "--accent": "#e5dfc5",
    "--accent-foreground": "#56646c",
    "--border": "#b9c0ab",
    "--input": "#b9c0ab",
    "--ring": "#627001",
    "--sidebar": "#eae4ca",
    "--sidebar-foreground": "#56646c",
    "--sidebar-accent": "#e5dfc5",
    "--sidebar-accent-foreground": "#56646c",
    "--sidebar-border": "#b9c0ab",
    "--sidebar-ring": "#627001"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7b8579",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#5c6a72"
      }
    },
    {
      "name": "Built-in variables",
      "scope": [
        "variable.language",
        "support.variable.property.dom"
      ],
      "settings": {
        "foreground": "#c25ba1"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#c25ba1"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#c25ba1"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#e04d4a"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#c8661f"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#c8661f"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#2e916c"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#788901"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#788901"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#a87900"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#a87900"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3589b6"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5c6a72"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#c8661f"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#c25ba1"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#c25ba1"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#c8661f",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3589b6",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#7b8579",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#e04d4a"
      }
    }
  ]
}
