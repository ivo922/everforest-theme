{
  "base": "light",
  "tokens": {
    "--background": "#fdf6e3",
    "--editor-surface": "#fdf6e3",
    "--foreground": "#5c6a72",
    "--card": "#f4f0d9",
    "--card-foreground": "#5c6a72",
    "--popover": "#fdf6e3",
    "--popover-foreground": "#5c6a72",
    "--primary": "#687701",
    "--primary-foreground": "#fdf6e3",
    "--secondary": "#f4f0d9",
    "--secondary-foreground": "#5c6a72",
    "--muted": "#f4f0d9",
    "--muted-foreground": "#626d61",
    "--accent": "#efebd4",
    "--accent-foreground": "#5c6a72",
    "--border": "#bdc3af",
    "--input": "#bdc3af",
    "--ring": "#687701",
    "--sidebar": "#f4f0d9",
    "--sidebar-foreground": "#5c6a72",
    "--sidebar-accent": "#efebd4",
    "--sidebar-accent-foreground": "#5c6a72",
    "--sidebar-border": "#bdc3af",
    "--sidebar-ring": "#687701"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#828d80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "support.variable",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#5c6a72"
      }
    },
    {
      "name": "Built-in variables",
      "scope": [
        "variable.language",
        "support.variable.property.dom"
      ],
      "settings": {
        "foreground": "#ce61ac"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "support.constant",
        "variable.other.constant",
        "constant.language"
      ],
      "settings": {
        "foreground": "#ce61ac"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#ce61ac"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "keyword.control"
      ],
      "settings": {
        "foreground": "#ee524f"
      }
    },
    {
      "name": "Storage modifiers",
      "scope": [
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#d56d21"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#d56d21"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "punctuation.definition.string",
        "markup.inline.raw",
        "markup.raw"
      ],
      "settings": {
        "foreground": "#319a72"
      }
    },
    {
      "name": "Escapes and regular expressions",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7f9201"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#7f9201"
      }
    },
    {
      "name": "Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#b38000"
      }
    },
    {
      "name": "Namespaces",
      "scope": [
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#b38000"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#3991c1"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#5c6a72"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#d56d21"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#ce61ac"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#ce61ac"
      }
    },
    {
      "name": "Headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#d56d21",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#3991c1",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#828d80",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ee524f"
      }
    }
  ]
}
